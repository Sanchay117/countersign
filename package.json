{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The second signature on every agent payment. SERV Reasoning checks each x402 payment against the user's mandate before the wallet signs.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bench": "tsx --env-file=.env.local scripts/bench.ts",
    "wallets": "tsx scripts/wallets.ts",
    "doctor": "tsx --env-file=.env.local scripts/doctor.ts",
    "pay": "tsx --env-file=.env.local scripts/pay.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@x402/core": "^2.31.0",
    "@x402/evm": "^2.31.0",
    "@x402/fetch": "^2.31.0",
    "@x402/next": "^2.31.0",
    "next": "^16.4.6",
    "openai": "^7.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
